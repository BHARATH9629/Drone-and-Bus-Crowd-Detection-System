# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=busdb

# Blynk IoT Configuration
BLYNK_AUTH_TOKEN=your_blynk_auth_token_here
BLYNK_BASE_URL=https://blynk.cloud/external/api/update

# Groq AI Assistant Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_CHAT_URL=https://api.groq.com/openai/v1/chat/completions

# Camera & Detection Settings (Optional overrides)
PHONE_CAM_IP=192.168.1.5
PHONE_CAM_PORT=8080
ESP32_IP=192.168.1.50
DASHBOARD_URL=http://localhost:3000/api/detection

# Server Port
PORT=3000
